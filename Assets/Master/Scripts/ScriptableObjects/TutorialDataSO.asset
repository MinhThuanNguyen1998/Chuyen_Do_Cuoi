  - m_AvatarSprite: {fileID: 21300000, guid: 33db3e7ddb393314594b9819ef86ad68, type: 3}
    m_TextContent: 
    m_HintDescription: "Th\u1EED t\xECm \u1EDF t\u01B0\u1EDDng, k\u1EC7 s\xE1ch,
      ho\u1EB7c t\u1EE7"
    m_VoiceAudio: {fileID: 0}
  - m_AvatarSprite: {fileID: 21300000, guid: 33db3e7ddb393314594b9819ef86ad68, type: 3}
    m_TextContent: "M\xE1y casset v\u1EABn c\xF2n ch\u1EA1y \u0111\u01B0\u1EE3c...\nTh\u1EED
      nghe xem"
    m_HintDescription: 
